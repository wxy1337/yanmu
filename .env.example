# 服务
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=4096
MAX_CONCURRENT_JOBS=1
MAX_PENDING_JOBS=20
MIN_FREE_DISK_MB=1024
MEDIA_TIMEOUT_SECONDS=14400
# 如果 FFmpeg 未加入 PATH，可填写绝对路径
FFMPEG_BINARY=
FFPROBE_BINARY=

# 网页默认语音识别模型：tiny / base / small / medium / large-v3 / distil-large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# auto 自动使用可用的 NVIDIA CUDA；也可设置 cpu / cuda
ACCELERATION_MODE=auto
# auto / h264_nvenc / h264_qsv / h264_amf / h264_videotoolbox
GPU_VIDEO_ENCODER=auto
# Windows 可指定包含 cublas64_12.dll / cudnn64_9.dll 的目录
CUDA_DLL_DIRECTORY=

# 翻译（仅外语视频需要）
# openai_compatible: OpenAI、Ollama、LM Studio 等兼容接口
# libretranslate: 自建 LibreTranslate
TRANSLATION_PROVIDER=openai_compatible
TRANSLATION_BASE_URL=https://api.openai.com/v1
TRANSLATION_API_KEY=
TRANSLATION_MODEL=gpt-4.1-mini
TRANSLATION_TIMEOUT_SECONDS=90
TRANSLATION_RETRIES=2

# LibreTranslate 示例
# TRANSLATION_PROVIDER=libretranslate
# TRANSLATION_BASE_URL=http://localhost:5000
# TRANSLATION_API_KEY=
